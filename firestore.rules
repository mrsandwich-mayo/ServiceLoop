rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: default-deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && isValidId(businessId) && request.auth.uid == businessId;
    }

    function isValidBusiness(data) {
      return data.keys().hasAll(['ownerId', 'ownerName', 'businessName', 'businessType', 'location', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 100
        && data.businessType is string && data.businessType.size() >= 1 && data.businessType.size() <= 50
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 120
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 120));
    }

    // Business profile document - strictly keyed by owner UID
    match /businesses/{businessId} {
      allow get: if isBusinessOwner(businessId)
        && existing().ownerId == request.auth.uid;

      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isBusinessOwner(businessId)
        && isValidBusiness(incoming())
        && incoming().ownerId == request.auth.uid;

      allow update: if isBusinessOwner(businessId)
        && isValidBusiness(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt;

      allow delete: if isBusinessOwner(businessId)
        && existing().ownerId == request.auth.uid;

      // Subcollections: clients, followups, tasks, invoices
      // Scoped strictly under /businesses/{businessId}/... where businessId == request.auth.uid
      match /{subcollection}/{docId} {
        allow get, list: if isBusinessOwner(businessId);

        allow create: if isBusinessOwner(businessId)
          && isValidId(docId)
          && incoming().ownerId == request.auth.uid;

        allow update: if isBusinessOwner(businessId)
          && isValidId(docId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId;

        allow delete: if isBusinessOwner(businessId)
          && isValidId(docId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
