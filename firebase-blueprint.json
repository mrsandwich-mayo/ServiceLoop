{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "V1 core business tenant profile isolated by owner UID",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the business owner",
          "minLength": 1,
          "maxLength": 128
        },
        "businessName": {
          "type": "string",
          "description": "Registered trade name of the business",
          "minLength": 1,
          "maxLength": 100
        },
        "ownerName": {
          "type": "string",
          "description": "Full name of the business owner",
          "minLength": 1,
          "maxLength": 100
        },
        "businessType": {
          "type": "string",
          "description": "Industry vertical or service trade category",
          "minLength": 1,
          "maxLength": 100
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "PENDING_VERIFICATION",
            "VERIFIED",
            "REJECTED",
            "SUSPENDED"
          ],
          "description": "Business identity verification status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "location": {
          "type": "string",
          "description": "Operating city, district, or physical base",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Business contact phone",
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Business contact email",
          "maxLength": 120
        }
      },
      "required": [
        "ownerId",
        "businessName",
        "ownerName",
        "businessType",
        "verificationStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "BusinessVerification": {
      "title": "BusinessVerification",
      "description": "Business identity verification record with safe masked identifiers",
      "type": "object",
      "properties": {
        "businessId": {
          "type": "string",
          "description": "ID of the associated business",
          "minLength": 1,
          "maxLength": 128
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "PENDING",
            "VERIFIED",
            "REJECTED"
          ],
          "description": "Verification review decision"
        },
        "documentType": {
          "type": "string",
          "description": "Document classification such as GSTIN or Trade License",
          "minLength": 1,
          "maxLength": 50
        },
        "documentReference": {
          "type": "string",
          "description": "Masked non-sensitive document identifier",
          "minLength": 1,
          "maxLength": 100
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        },
        "reviewedBy": {
          "type": "string",
          "description": "UID of reviewing administrator or null",
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Review completion timestamp or null"
        },
        "rejectionReason": {
          "type": "string",
          "description": "Reason notes in case of verification rejection",
          "maxLength": 500
        }
      },
      "required": [
        "businessId",
        "verificationStatus",
        "documentType",
        "documentReference",
        "submittedAt"
      ]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client profile scoped strictly to a specific business",
      "type": "object",
      "properties": {
        "businessId": {
          "type": "string",
          "description": "Owning business ID",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Full name of the customer",
          "minLength": 1,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email address",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "description": "Customer service history and preferences",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "businessId",
        "name",
        "createdAt",
        "updatedAt"
      ]
    },
    "Service": {
      "title": "Service",
      "description": "Service catalog offering for a specific business",
      "type": "object",
      "properties": {
        "businessId": {
          "type": "string",
          "description": "Owning business ID",
          "minLength": 1,
          "maxLength": 128
        },
        "serviceName": {
          "type": "string",
          "description": "Display name of the service",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the service scope",
          "maxLength": 1000
        },
        "durationMinutes": {
          "type": "number",
          "description": "Estimated service duration in minutes"
        },
        "typicalIntervalDays": {
          "type": "number",
          "description": "Typical follow-up or recurring cadence in days"
        },
        "basePrice": {
          "type": "number",
          "description": "Standard base price in local currency"
        },
        "isActive": {
          "type": "boolean",
          "description": "Active status for booking"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "businessId",
        "serviceName",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled booking linking a customer, service, and business",
      "type": "object",
      "properties": {
        "businessId": {
          "type": "string",
          "description": "Owning business ID",
          "minLength": 1,
          "maxLength": 128
        },
        "customerId": {
          "type": "string",
          "description": "Referenced customer ID",
          "minLength": 1,
          "maxLength": 128
        },
        "serviceId": {
          "type": "string",
          "description": "Referenced service catalog ID",
          "minLength": 1,
          "maxLength": 128
        },
        "appointmentDate": {
          "type": "string",
          "description": "Date of appointment in ISO YYYY-MM-DD format",
          "minLength": 8,
          "maxLength": 30
        },
        "appointmentTime": {
          "type": "string",
          "description": "Start time in HH:mm format",
          "minLength": 2,
          "maxLength": 20
        },
        "endTime": {
          "type": "string",
          "description": "Optional completion time in HH:mm format",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": [
            "SCHEDULED",
            "COMPLETED",
            "CANCELLED",
            "NO_SHOW"
          ],
          "description": "Appointment lifecycle state"
        },
        "notes": {
          "type": "string",
          "description": "Appointment instructions or job notes",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "businessId",
        "customerId",
        "serviceId",
        "appointmentDate",
        "appointmentTime",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "FollowUp": {
      "title": "FollowUp",
      "description": "Post-service customer re-engagement schedule",
      "type": "object",
      "properties": {
        "businessId": {
          "type": "string",
          "description": "Owning business ID",
          "minLength": 1,
          "maxLength": 128
        },
        "customerId": {
          "type": "string",
          "description": "Referenced customer ID",
          "minLength": 1,
          "maxLength": 128
        },
        "appointmentId": {
          "type": "string",
          "description": "Originating appointment ID",
          "minLength": 1,
          "maxLength": 128
        },
        "scheduledDate": {
          "type": "string",
          "description": "Follow-up due date in ISO YYYY-MM-DD format",
          "minLength": 8,
          "maxLength": 30
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "COMPLETED",
            "CANCELLED"
          ],
          "description": "Follow-up action status"
        },
        "notes": {
          "type": "string",
          "description": "Follow-up call or check-in notes",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "businessId",
        "customerId",
        "appointmentId",
        "scheduledDate",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": {
        "$ref": "#/entities/Business"
      },
      "description": "Stores individual business profiles isolated by owner UID"
    },
    "/business_verifications/{verificationId}": {
      "schema": {
        "$ref": "#/entities/BusinessVerification"
      },
      "description": "Stores business identity verification records"
    },
    "/customers/{customerId}": {
      "schema": {
        "$ref": "#/entities/Customer"
      },
      "description": "Stores customer records scoped to owning business"
    },
    "/services/{serviceId}": {
      "schema": {
        "$ref": "#/entities/Service"
      },
      "description": "Stores service catalog items scoped to owning business"
    },
    "/appointments/{appointmentId}": {
      "schema": {
        "$ref": "#/entities/Appointment"
      },
      "description": "Stores appointment bookings scoped to owning business"
    },
    "/follow_ups/{followUpId}": {
      "schema": {
        "$ref": "#/entities/FollowUp"
      },
      "description": "Stores customer follow-up tasks scoped to owning business"
    }
  }
}
